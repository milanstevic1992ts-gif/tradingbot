# Copy to /etc/ge360/trading-paper.env via scripts/ge360-install-paper-service.sh
# Never commit real credentials.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
GE360_FORWARD_PAPER_STORE=/absolute/path/to/tradingbot/ge360-state/forward-paper.json
GE360_RECOVERY_CHECKPOINT=/absolute/path/to/tradingbot/ge360-state/recovery-checkpoint.json
